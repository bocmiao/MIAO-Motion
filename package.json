{
  "name": "miao-motion",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-mediapipe.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "pretest": "npm run prepare:assets",
    "test": "node --test tests/*.test.mjs",
    "build": "npm test && tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "npm run start"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixiv/three-vrm": "^3.5.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.8"
  },
  "engines": {
    "node": ">=22"
  }
}
