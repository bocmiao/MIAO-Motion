{
  "name": "miao-motion",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-mediapipe.mjs && node scripts/prepare-licenses.mjs",
    "fixtures:generate": "node scripts/generate-test-vrm.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "pretest": "npm run prepare:assets",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "build": "npm test && tsc --noEmit && vite build --emptyOutDir && node scripts/write-build-marker.mjs",
    "build:app": "npm run prepare:assets && vite build --emptyOutDir && node scripts/write-build-marker.mjs",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "npm run start"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixiv/three-vrm": "^3.5.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.8"
  },
  "engines": {
    "node": ">=22"
  }
}
